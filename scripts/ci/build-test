#!/usr/bin/env bash
set -eoux pipefail

pushd rust
# `deep_fuzz` re-enables the expensive fuzzers that a plain `cargo test`
# skips; CI is the place that can afford them.
RUST_LOG=error cargo test -p automerge --features slow_path_assertions,deep_fuzz
RUST_LOG=error cargo test -p hexane --features slow_path_assertions,deep_fuzz
RUST_LOG=error cargo test -p automerge-test
RUST_LOG=error cargo test -p automerge-c
RUST_LOG=error cargo test -p automerge-cli
RUST_LOG=error cargo test -p automerge-wasm
popd
