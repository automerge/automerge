#!/usr/bin/env bash
set -eoux pipefail

# see https://stackoverflow.com/questions/4774054/reliable-way-for-a-bash-script-to-get-the-full-path-to-itself
THIS_SCRIPT="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
JS_PROJECT=$THIS_SCRIPT/../../javascript;

npm --prefix $JS_PROJECT install
node $JS_PROJECT/scripts/build.mjs
# Verify the public type surface against the committed API report
# (etc/automerge.api.md). Regenerate locally with `npm run api-update`.
npm --prefix $JS_PROJECT run api-check
npm --prefix $JS_PROJECT test
npm --prefix $JS_PROJECT run packaging-tests
